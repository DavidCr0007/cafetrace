# Configuración general
PROJECT_NAME="CaféTrace IA"
API_V1_STR="/api/v1"
ENVIRONMENT=development

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafetrace"

# Seguridad y Autenticación JWT
SECRET_KEY="cambiar-esta-clave-secreta-en-produccion-por-una-aleatoria-de-64-caracteres"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Solo desarrollo: si no se define, el seed genera una contraseña aleatoria.
SEED_ADMIN_PASSWORD=

# Pronóstico usado como contexto IoT
WEATHER_LOCATION_NAME="Icononzo, Tolima, Colombia"
WEATHER_LATITUDE=4.1767
WEATHER_LONGITUDE=-74.5325
WEATHER_TIMEZONE="America/Bogota"
WEATHER_FORECAST_DAYS=7

# Blockchain (Polygon Amoy). Keep private key only in a secret manager.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_TX_TIMEOUT_SECONDS=120
IOT_MAX_CLOCK_SKEW_SECONDS=300
